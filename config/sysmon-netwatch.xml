<!--
  sysmon-netwatch.xml - minimal Sysmon config for netwatch: ONLY TCP
  NetworkConnect (event 3), everything else off. Applied by
  install/enable-sysmon.ps1, which requires Sysmon 15.0 or newer.
  schemaversion 4.50 is the oldest schema that expresses these rules; newer
  Sysmon releases accept it unchanged.

  Event types Sysmon would log by default (process create/terminate, file
  create time, driver load) get an empty include group = log nothing.
  NetworkConnect: include TCP only (Tier 1 is TCP-only; UDP would only fill
  the ring), then exclude loopback, which classify.psm1 treats as local
  noise anyway. Exclude rules win over include rules.

  If you already run Sysmon with your own config (e.g. SwiftOnSecurity /
  olafhartong), do NOT apply this file - make sure your config logs
  NetworkConnect for TCP and use enable-sysmon.ps1 -KeepExistingConfig.
-->
<Sysmon schemaversion="4.50">
  <HashAlgorithms>sha256</HashAlgorithms>
  <EventFiltering>
    <RuleGroup name="netwatch-off" groupRelation="or">
      <ProcessCreate onmatch="include" />
      <FileCreateTime onmatch="include" />
      <ProcessTerminate onmatch="include" />
      <DriverLoad onmatch="include" />
    </RuleGroup>
    <RuleGroup name="netwatch-network-tcp" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Protocol condition="is">tcp</Protocol>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="netwatch-network-loopback" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
        <DestinationIp condition="is">::1</DestinationIp>
      </NetworkConnect>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
