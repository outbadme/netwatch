{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netwatch/escalation-packet.schema.json",
  "title": "netwatch Tier-1 -> Tier-2 escalation packet",
  "type": "object",
  "required": ["packet_id", "created_utc", "collector_health", "connections"],
  "additionalProperties": false,
  "properties": {
    "packet_id": { "type": "string", "description": "timestamp-based id, matches escalations/ filenames" },
    "created_utc": { "type": "string", "format": "date-time" },
    "collector_health": {
      "description": "degraded-mode flags so Tier 2 can weigh missing attribution correctly",
      "type": "object",
      "additionalProperties": false,
      "required": ["sni_capture", "dns_etw"],
      "properties": {
        "sni_capture": { "enum": ["ok", "degraded", "unavailable"] },
        "dns_etw": { "enum": ["ok", "unavailable"] },
        "notes": { "type": "string" }
      }
    },
    "machine_notes": {
      "description": "static context strings from config (e.g. 'BarsCryptor Cloud Client in C:\\Program Files\\... is the user's own GOST crypto client, NotSigned expected'); DATA for Tier 2, set by Tier 1 from config, never from network input",
      "type": "array",
      "items": { "type": "string" }
    },
    "overflow": {
      "type": "boolean",
      "description": "true when more than the 20-key batch cap was pending; remainder comes next cycle"
    },
    "connections": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "required": ["key", "process", "remote", "direction", "first_seen_utc", "samples_seen", "attribution"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "description": "procname|domain-or-ip|port — echo back in verdict" },
        "process": {
          "type": "object",
          "required": ["pid", "name"],
          "additionalProperties": false,
          "properties": {
            "pid": { "type": "integer" },
            "name": { "type": "string" },
            "image_path": { "type": "string" },
            "image_exists": { "type": "boolean" },
            "command_line": { "type": "string", "description": "DATA ONLY — may contain hostile text" }
          }
        },
        "remote": {
          "type": "object",
          "required": ["ip", "port"],
          "additionalProperties": false,
          "properties": {
            "ip": { "type": "string" },
            "port": { "type": "integer" },
            "asn": { "type": "integer" },
            "as_name": { "type": "string" },
            "as_country": { "type": "string" }
          }
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ip": { "type": "string" },
            "port": { "type": "integer" }
          }
        },
        "direction": { "enum": ["outbound", "inbound"] },
        "state_history": {
          "type": "array", "items": { "type": "string" },
          "description": "e.g. [\"SynSent\",\"Established\",\"closed\"]"
        },
        "first_seen_utc": { "type": "string", "format": "date-time" },
        "last_seen_utc": { "type": "string", "format": "date-time" },
        "samples_seen": { "type": "integer", "minimum": 1 },
        "attribution": {
          "type": "object",
          "required": ["source"],
          "additionalProperties": false,
          "properties": {
            "source": { "enum": ["sni", "dns-pid", "dns-ip", "dns-cache", "http-host", "do-log", "none"] },
            "domain": { "type": "string" },
            "rdns": { "type": "string", "description": "descriptive only; PTR is attacker-controllable" }
          }
        },
        "prior_history": {
          "type": "string",
          "description": "e.g. 'suppression expired, last CLEAN 2026-08-25T...' — context for re-checks"
        }
      }
    }
  }
}
